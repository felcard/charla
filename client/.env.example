# REACT_APP_SERVER_URL is the Socket.IO server the client connects to.
# - npm start uses http://localhost:8000 (set in .env.development)
# - production builds use the live server unless this is set in the host's
#   build settings (e.g. Netlify environment variables)
# To override locally, put it in .env.development.local (not committed).
REACT_APP_SERVER_URL=http://localhost:8000
